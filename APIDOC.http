# user  endpoints

# api call for creating user
###
POST  http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"user_02",
    "email":"user02@gmail.com",
    "password":"password@123"
}

# api call for token generation
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"user_02",
    "password":"password@123"
}


#api call for getting user details
###
GET http://127.0.0.1:8000/v1/spending/getme/
Accept: application/json
#Authorization: Basic user_01:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

# Expense endpoints ========================

#api call for listing all expenses
###
GET http://127.0.0.1:8000/v1/spending/expenses/
Accept: application/json
# Authorization: Basic user_01:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

#api call for creating expense
###
POST http://127.0.0.1:8000/v1/spending/expenses/
Content-Type: application/json
# Authorization: Basic user_01:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

{
    "title":"",
    "amount":500,
    "category":"FOOD",
    "payment_method":"upi"
}

#api call for listing specific expenses
###
GET http://127.0.0.1:8000/v1/spending/expenses/4/
Accept: application/json
# Authorization: Basic user_02:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

# api call for updating expense
###
PUT http://127.0.0.1:8000/v1/spending/expenses/3/
Content-Type: application/json
# Authorization: Basic user_02:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

{
    "title":"petrol",
    "amount":1500,
    "category":"OTHER",
    "payment_method":"cash"
}

# api call for deleting expense
###
DELETE http://127.0.0.1:8000/v1/spending/expenses/2/
Accept: application/json
# Authorization: Basic user_01:password@123
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8


# api call for spending summary
###
GET http://127.0.0.1:8000/v1/spending/expenses/summary/
Accept: application/json
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8

# budgetplan api call
###
GET http://127.0.0.1:8000/v1/spending/budgetplan/
Accept: application/json
Authorization: Token 3e9f340153cf3869450d28704ea65f5e7095f9b8
